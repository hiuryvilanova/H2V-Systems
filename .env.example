# ============================================================
# H2V Systems — variáveis de ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite .env.local — ele está no .gitignore.

# Resend (envio de e-mails do formulário e newsletter)
# Crie sua key gratuita em https://resend.com/api-keys
RESEND_API_KEY=

# E-mail que recebe as mensagens do formulário de contato
CONTACT_TO_EMAIL=hiuryhenrique2012@gmail.com

# Remetente exibido nos e-mails enviados
# Em desenvolvimento, pode usar "onboarding@resend.dev"
# Em produção, configure seu domínio no Resend e use algo como "contato@h2vsystems.com.br"
# ⚠ onboarding@resend.dev só entrega para o e-mail dono da conta Resend.
CONTACT_FROM_EMAIL=H2V Systems <onboarding@resend.dev>

# E-mail que recebe inscrições de newsletter (opcional; cai no CONTACT_TO_EMAIL se vazio)
NEWSLETTER_TO_EMAIL=

# (Opcional) ID de um Segment do Resend (Contacts → Segments) para guardar os inscritos
# da newsletter. Com ele, dá para enviar broadcasts e o descadastro é automático (LGPD).
RESEND_SEGMENT_ID=

# ============================================================
# Upstash Redis (rate limiting persistente em produção)
# ============================================================
# Crie um database REST gratuito em https://upstash.com/
# Se as variáveis não estiverem setadas, o rate limit cai para memória local
# (funciona em dev, mas perde estado a cada cold start em produção serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
